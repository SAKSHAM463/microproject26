# MitShop Environment Variables
# Copy this to .env and fill in the real values

# ====== REQUIRED — server will refuse to start without these ======

# Google OAuth client ID (Web application type)
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Only emails ending @<this domain> are allowed to sign in
# For MITS Gwalior: mitsgwl.ac.in
ALLOWED_EMAIL_DOMAIN=mitsgwl.ac.in

# Long random string for signing JWT cookies (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=replace-with-a-long-random-secret

# ====== OPTIONAL but strongly recommended ======

# Comma-separated list of college email addresses who have admin access
# Example: admin1@mitsgwl.ac.in,admin2@mitsgwl.ac.in
ADMIN_EMAILS=

# Port for local development server
PORT=3000

# Set to "production" when deploying
NODE_ENV=development
