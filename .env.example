# MitShop Environment Variables
# Copy this to .env and fill in real values for your environment

# ===================================================================
# REQUIRED
# ===================================================================

# Long random string for signing JWT cookies and deriving HMAC challenge keys
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# ===================================================================
# COLLEGE & CAMPUS SETTINGS
# ===================================================================

# Primary deployment campus domain (fallback / default)
ALLOWED_EMAIL_DOMAIN=mitsgwl.ac.in

# Comma-separated list of college email addresses granted administrative access
# Example: admin1@mitsgwl.ac.in,dean@mitsgwl.ac.in
ADMIN_EMAILS=

# ===================================================================
# SECURITY & SESSION LIFETIMES
# ===================================================================

# Optional dedicated 32-byte hex secret for challenge HMACs and delivery email encryption
# If omitted, securely derived from SESSION_SECRET
# CHALLENGE_HMAC_SECRET=

# Idle session timeout in seconds (default: 30 days = 2592000)
SESSION_IDLE_TIMEOUT_SECONDS=2592000

# Absolute maximum session lifetime in seconds (default: 90 days = 7776000)
SESSION_ABSOLUTE_TIMEOUT_SECONDS=7776000

# Base URL origin of your marketplace application (used for CORS, cookies, magic links)
# Development: http://localhost:3000
# Production: https://mitstore.netlify.app
SITE_ORIGIN=http://localhost:3000

# ===================================================================
# TRANSACTIONAL EMAIL DELIVERY (SPF, DKIM, DMARC)
# ===================================================================

# Sender name and email address appearing in outbox messages
EMAIL_FROM="MitShop Auth <auth@campus-marketplace.edu>"

# Production transactional email service credentials (e.g. Resend, Sendgrid, Postmark)
# In development (NODE_ENV=development), a secure mock transport outputs to console and in-memory outbox.
# In production (NODE_ENV=production), mock transport CANNOT activate and real credentials are required.
EMAIL_API_KEY=
EMAIL_API_URL=https://api.resend.com/emails

# Secret used to verify incoming webhook signatures for email bounces and delivery reports
EMAIL_WEBHOOK_SECRET=

# ===================================================================
# OPTIONAL / LEGACY
# ===================================================================

# Google OAuth client ID (only needed if supporting optional Google Sign-In)
GOOGLE_CLIENT_ID=

# Expose debug verification codes in HTTP response (STRICTLY FOR TESTS / DEV ONLY)
# DEBUG_AUTH=false

# Port and Node Environment
PORT=3000
NODE_ENV=development
